# Faster-FastWAM: the measured configuration (LIBERO recipe, 3.46x on 8 GPUs).
# Every switch is off unless set here; with none set the trainer runs the upstream code path.
# Usage: source scripts/configs/faster.env
export FASTWAM_OPT_PRESAMPLE=1        # decode and transform only the video frames the model uses (bit-identical)
export FASTWAM_OPT_FASTROWS=1         # rows from whole-column tensors instead of per-item HF select (bit-identical)
export FASTWAM_OPT_U8FRAMES=1         # uint8 frames out of the video decoder (bit-identical)
export FASTWAM_OPT_TEXTMEMO=1         # per-worker memo of the T5 cache, unbounded: few distinct instructions only (bit-identical)
export FASTWAM_OPT_NOSYNC=1           # no per-step host synchronisation (bit-identical)
export FASTWAM_OPT_VAE_INDUCTOR=1     # Inductor-compiled VAE encode (rounding differs)
export FASTWAM_OPT_COMPILE_DENOISE=1  # upstream's regional compile of the MoT layers (rounding differs)
